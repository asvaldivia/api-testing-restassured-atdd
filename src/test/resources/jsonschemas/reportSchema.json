{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Report Response Schema",
  "type": "object",
  "required": ["report"],
  "properties": {
    "report": {
      "type": "array",
      "minItems": 1,
      "items": {
        "required": ["start", "end", "title"],
        "type": "object",
        "properties": {
          "start": { "type": "string" },
          "end": { "type": "string" },
          "title": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}